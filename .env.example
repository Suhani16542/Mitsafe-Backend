# Server Configuration
PORT=5000
NODE_ENV=development # Options: development, production

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/mitsafe

# Security & Admin Authentication Configuration
ADMIN_EMAIL=admin@mitsafe.com
ADMIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
BLOG_ADMIN_API_KEY=your_secure_blog_admin_api_key_here

# CORS Configuration
CORS_ORIGIN=https://www.mitsafe.com,http://localhost:3000
CLIENT_URL=http://localhost:3000

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@mitsafe.com
BREVO_SENDER_NAME=Mitsafe Systems
QUOTE_NOTIFICATION_EMAIL=info@mitsafe.com

# Cloudinary Storage Configuration (Optional - falls back to local disk storage if unconfigured)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

